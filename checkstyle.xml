<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.sourceforge.io/dtds/configuration_1_3.dtd">

<module name="Checker">

    <module name="TreeWalker">
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="caseIndent" value="4"/>
        </module>
        <module name="FileTabCharacter">
            <property name="forbidTab" value="true"/>
        </module>
        <module name="LineLength">
            <property name="max" value="120"/>
        </module>
        <module name="NoWhitespaceBefore">
            <property name="tokens" value="LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, LITERAL_WHILE, LITERAL_SWITCH"/>
        </module>
        <module name="NoWhitespaceAfter">
            <property name="tokens" value="LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, LITERAL_WHILE, LITERAL_SWITCH"/>
        </module>
        <module name="JavadocType">
            <property name="checkAnnotations" value="true"/>
        </module>
    </module>

    <module name="NamingConvention">
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ClassName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
    </module>

    <module name="MethodLength">
        <property name="max" value="100"/>
    </module>
    <module name="ClassDataAbstractionCoupling">
        <property name="min" value="5"/>
    </module>

    <module name="ImportOrder">
        <property name="separateLines" value="true"/>
    </module>
    <module name="VisibilityModifier">
        <property name="visibility" value="public"/>
    </module>
</module>
